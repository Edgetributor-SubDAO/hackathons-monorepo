# Stellar Testnet Configuration
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org:443
STELLAR_ACCOUNT_SECRET=S...  # Stellar secret key (starts with S)
STELLAR_ACCOUNT_PUBLIC=G...  # Stellar public key (starts with G)
STELLAR_CONTRACT_ID=C...     # Deployed Stellar bridge contract ID

# Polkadot Testnet Configuration (Contracts on Rococo)
POLKADOT_NETWORK=rococo-contracts
POLKADOT_RPC_URL=wss://rococo-contracts-rpc.polkadot.io
POLKADOT_ACCOUNT_SEED=//Alice  # Or your seed phrase
POLKADOT_ACCOUNT_ADDRESS=5...  # Polkadot account address
POLKADOT_CONTRACT_ADDRESS=5... # Deployed Polkadot verifier contract address

# Bridge Configuration
MIN_LOCK_TIME=3600           # 1 hour in seconds
RELAYER_FEE=1000000          # Fee in stroops (0.1 XLM)

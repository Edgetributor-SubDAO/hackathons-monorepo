        "@polkadot/api": "^12.4.2",
        "@stellar/stellar-sdk": "^12.3.0",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "ioredis": "^5.3.2",
        "pg": "^8.11.3",

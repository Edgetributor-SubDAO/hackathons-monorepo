{
    "name": "@chainspeed/api",
    "version": "1.0.0",
    "main": "./src/index.ts",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "dev:real": "USE_REAL_ADAPTERS=true tsx watch src/index.ts",

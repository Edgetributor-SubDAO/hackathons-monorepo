# ═══════════════════════════════════════════════════════════════════════════
#                    CHAINSPEED API - ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# Server Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
REGION=us-east

# Database (PostgreSQL + TimescaleDB)
DATABASE_URL=postgresql://chainspeed:chainspeed_dev_password@localhost:5432/chainspeed

# Cache (Redis)
REDIS_URL=redis://localhost:6379

# ═══════════════════════════════════════════════════════════════════════════
#                    ADAPTER CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# Set to 'true' to use real blockchain SDKs instead of simulated data
# Default is 'false' for faster MVP development
USE_REAL_ADAPTERS=false

# ═══════════════════════════════════════════════════════════════════════════
#                    POLKADOT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# Default Polkadot RPC endpoint (used in benchmark mode)
POLKADOT_WS=wss://rpc.polkadot.io

# Subscan API key for XCM and slashing event data
# Get your API key at: https://pro.subscan.io/
SUBSCAN_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════
#                    STELLAR CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# Default Stellar Horizon endpoint
STELLAR_HORIZON=https://horizon.stellar.org

# Soroban RPC endpoint for smart contract metrics
SOROBAN_RPC=https://soroban-rpc.mainnet.stellar.gateway.fm

# ═══════════════════════════════════════════════════════════════════════════
#                    TEST SETTINGS
# ═══════════════════════════════════════════════════════════════════════════

TEST_TIMEOUT=60000
SAMPLE_COUNT=20
CONCURRENT_TESTS=5

# ═══════════════════════════════════════════════════════════════════════════
#                    OPTIONAL: YOUR OWN NODES (for Network Benchmark Mode)
# ═══════════════════════════════════════════════════════════════════════════

# If running your own Polkadot node for accurate benchmark data:
# POLKADOT_NODE_WS=ws://your-polkadot-node:9944

# If running your own Stellar node:
# STELLAR_NODE_URL=http://your-stellar-node:11625

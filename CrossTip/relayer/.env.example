# Stellar Configuration
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_CONTRACT_ID=YOUR_SOROBAN_CONTRACT_ID_HERE
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Relayer Signing Key (secp256k1)
RELAYER_PRIVATE_KEY=YOUR_RELAYER_PRIVATE_KEY_HEX_HERE

# Polkadot Configuration
POLKADOT_WS_ENDPOINT=ws://localhost:9944
POLKADOT_CONTRACT_ADDRESS=YOUR_INK_CONTRACT_ADDRESS_HERE
POLKADOT_SIGNER_SEED=//Alice

# Relayer Settings
BATCH_INTERVAL_MS=15000
MIN_BATCH_SIZE=1
MAX_BATCH_SIZE=100

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crosstip_relayer

# Logging
LOG_LEVEL=info

# HTTP Server
PORT=3001
